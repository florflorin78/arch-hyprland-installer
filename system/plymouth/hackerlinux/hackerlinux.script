// Boot splash: avatar with HUD ring, data streams, boot log lines, progress bar, LUKS prompt.

Window.SetBackgroundTopColor(0.047, 0.055, 0.086);
Window.SetBackgroundBottomColor(0.031, 0.035, 0.055);

sw = Window.GetWidth();
sh = Window.GetHeight();

fun pseudo (seed) {
    v = Math.Sin(seed * 12.9898) * 43758.5453;
    v = v - Math.Int(v);
    if (v < 0) v = v + 1;
    return v;
}

// ---- falling columns ----
rain_img[0] = Image("rain0.png");
rain_img[1] = Image("rain1.png");
rain_img[2] = Image("rain2.png");
rain_img[3] = Image("rain3.png");

step = 60;
ncols = Math.Int(sw / step);
for (c = 0; c < ncols; c++) {
    kind = Math.Int(pseudo(c + 1) * 3.99);
    col[c].h = rain_img[kind].GetHeight();
    col[c].x = c * step + 10;
    col[c].y = -pseudo(c + 50) * sh;
    col[c].speed = 1 + pseudo(c + 90) * 3;
    col[c].sprite = Sprite(rain_img[kind]);
    col[c].sprite.SetOpacity(0.15 + pseudo(c + 130) * 0.30);
    col[c].sprite.SetPosition(col[c].x, col[c].y, 1);
}

// ---- center panel ----
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = sw / 2 - logo.image.GetWidth() / 2;
logo.y = sh / 2 - 290;
logo.sprite.SetPosition(logo.x, logo.y, 10);

title.image = Image("title.png");
title.sprite = Sprite(title.image);
title.sprite.SetPosition(sw / 2 - title.image.GetWidth() / 2, logo.y + logo.image.GetHeight() + 4, 10);

lx = sw / 2 - 270;
ly = sh / 2 + 10;
panel = Sprite(Image("panel.png"));
panel.SetPosition(lx - 20, ly - 14, 9);

for (i = 0; i < 5; i++) {
    if (i == 0) img = Image("line0.png");
    if (i == 1) img = Image("line1.png");
    if (i == 2) img = Image("line2.png");
    if (i == 3) img = Image("line3.png");
    if (i == 4) img = Image("line4.png");
    line[i] = Sprite(img);
    line[i].SetPosition(lx, ly + i * 32, 10);
    line[i].SetOpacity(0);
}
line[0].SetOpacity(1);

bar_bg = Sprite(Image("bar_bg.png"));
bar_bg.SetPosition(lx, ly + 5 * 32 + 14, 10);
bar_fill_img = Image("bar_fill.png");
bar_fill = Sprite(bar_fill_img);
bar_fill.SetPosition(lx + 2, ly + 5 * 32 + 16, 11);

fun progress_callback (duration, progress) {
    n = Math.Int(progress * 5) + 1;
    if (n > 5) n = 5;
    for (i = 0; i < 5; i++) {
        if (i < n) line[i].SetOpacity(1);
        else line[i].SetOpacity(0);
    }
    w = Math.Int(progress * 356);
    if (w < 1) w = 1;
    bar_fill.SetImage(bar_fill_img.Scale(w, 10));
}
Plymouth.SetBootProgressFunction(progress_callback);

// ---- glitch: every few seconds the logo jitters, a magenta ghost and bars flash ----
ghost.sprite = Sprite(Image("logo_ghost.png"));
ghost.sprite.SetOpacity(0);
ghost.sprite.SetPosition(logo.x, logo.y, 9);
gbar_img = Image("glitch_bar.png");
for (i = 0; i < 3; i++) {
    gbar[i] = Sprite(gbar_img);
    gbar[i].SetOpacity(0);
}
title.x = sw / 2 - title.image.GetWidth() / 2;
glitch_left = 0;

fun glitch_frame (t) {
    dx = (pseudo(t * 3.1) * 2 - 1) * 14;
    logo.sprite.SetX(logo.x + dx);
    title.sprite.SetX(title.x - dx * 0.6);
    ghost.sprite.SetPosition(logo.x - dx * 1.4, logo.y + 2, 9);
    ghost.sprite.SetOpacity(0.55);
    for (i = 0; i < 3; i++) {
        gbar[i].SetPosition(logo.x + pseudo(t + i * 7) * logo.image.GetWidth() * 0.4 - 20,
                            logo.y + pseudo(t * 1.7 + i) * logo.image.GetHeight(), 11);
        gbar[i].SetOpacity(0.5 + pseudo(t + i) * 0.4);
    }
}

fun glitch_reset () {
    logo.sprite.SetX(logo.x);
    title.sprite.SetX(title.x);
    ghost.sprite.SetOpacity(0);
    for (i = 0; i < 3; i++) gbar[i].SetOpacity(0);
}

// ---- animation ----
tick = 0;
fun refresh_callback () {
    tick = tick + 1;
    for (c = 0; c < ncols; c++) {
        col[c].y = col[c].y + col[c].speed;
        if (col[c].y > sh) col[c].y = -col[c].h;
        col[c].sprite.SetPosition(col[c].x, col[c].y, 1);
    }
    logo.sprite.SetOpacity(0.9 + 0.1 * Math.Sin(tick / 25));
    if (tick == 8 || tick % 150 == 0) glitch_left = 4 + Math.Int(pseudo(tick) * 5);
    if (glitch_left > 0) {
        glitch_frame(tick);
        glitch_left = glitch_left - 1;
        if (glitch_left == 0) glitch_reset();
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---- LUKS password prompt ----
prompt.image = Image("prompt.png");
prompt.sprite = Sprite(prompt.image);
prompt.sprite.SetOpacity(0);
py = ly + 5 * 32 + 52;
prompt.sprite.SetPosition(lx, py, 12);

hint.sprite = Sprite(Image("hint.png"));
hint.sprite.SetOpacity(0);
hint.sprite.SetPosition(lx, py + 34, 12);

star_img = Image("star.png");
for (i = 0; i < 40; i++) {
    star[i] = Sprite(star_img);
    star[i].SetOpacity(0);
    star[i].SetPosition(lx + prompt.image.GetWidth() + i * 13, py, 12);
}

fun display_password_callback (prompt_text, bullet_count) {
    prompt.sprite.SetOpacity(1);
    hint.sprite.SetOpacity(1);
    for (i = 0; i < 40; i++) {
        if (i < bullet_count) star[i].SetOpacity(1);
        else star[i].SetOpacity(0);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
    prompt.sprite.SetOpacity(0);
    hint.sprite.SetOpacity(0);
    for (i = 0; i < 40; i++) star[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
