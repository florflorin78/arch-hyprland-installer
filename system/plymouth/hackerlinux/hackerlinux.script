// Plymouth "hackerlinux": fundal închis, emblemă care pulsează, prompt pentru parola LUKS.

Window.SetBackgroundTopColor(0.027, 0.027, 0.047);
Window.SetBackgroundBottomColor(0.027, 0.027, 0.047);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

tick = 0;
fun refresh_callback () {
    tick = tick + 1;
    logo.sprite.SetOpacity(0.65 + 0.35 * Math.Sin(tick / 18));
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---- prompt parolă (necesar când discul e criptat cu LUKS) ----
prompt.sprite = Sprite();
bullets.sprite = Sprite();

fun display_password_callback (prompt_text, bullet_count) {
    label = Image.Text("Parola disc:", 0.55, 0.60, 0.78);
    prompt.sprite.SetImage(label);
    prompt.sprite.SetPosition(Window.GetWidth() / 2 - label.GetWidth() / 2,
                              logo.y + logo.image.GetHeight() + 30, 10);
    prompt.sprite.SetOpacity(1);

    stars = " ";
    for (i = 0; i < bullet_count; i++) stars = stars + "*";
    stars_img = Image.Text(stars, 1.0, 0.18, 0.39);
    bullets.sprite.SetImage(stars_img);
    bullets.sprite.SetPosition(Window.GetWidth() / 2 - stars_img.GetWidth() / 2,
                               logo.y + logo.image.GetHeight() + 70, 10);
    bullets.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
