#!/usr/bin/env bash
# powermenu — meniu wofi: blocare / suspend / logout / repornire / oprire
choice=$(printf '%s\n' "Lock" "Suspend" "Logout" "Reboot" "Shutdown" \
    | wofi --dmenu --prompt "Power" --width 320 --height 260) || exit 0

case $choice in
    Lock)     loginctl lock-session ;;
    Suspend)  systemctl suspend ;;
    Logout)   hyprctl dispatch 'hl.dsp.exit()' || loginctl terminate-user "$USER" ;;
    Reboot)   systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
esac
