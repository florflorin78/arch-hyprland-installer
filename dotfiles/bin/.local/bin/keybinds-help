#!/usr/bin/env bash
# Show all shortcuts, generated live from Hyprland (anything bound with a description).
hyprctl binds -j | jq -r '
    def mods: . as $m | [
        (select(($m/64|floor)%2==1) | "SUPER"),
        (select(($m/4|floor)%2==1)  | "CTRL"),
        (select(($m/8|floor)%2==1)  | "ALT"),
        (select(($m/1|floor)%2==1)  | "SHIFT")
    ];
    [ .[] | select((.description // "") != "")
          | ([(.modmask | mods[]), .key] | join(" + ")) + "\t" + .description ]
    | sort | .[]
' | column -t -s $'\t' | wofi --dmenu --prompt "Shortcuts" --width 820 --height 640 >/dev/null
