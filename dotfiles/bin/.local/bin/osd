#!/usr/bin/env bash
# osd volume up|down|mute | mic | brightness up|down — change and show a progress notification.
set -u

notify() {   # notify TITLE PERCENT [TEXT]
    notify-send -t 1200 -h string:x-canonical-private-synchronous:osd -h "int:value:$2" "$1" "${3:-}"
}

case ${1:-} in
    volume)
        case ${2:-} in
            up)   wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
            down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
            mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
        esac
        out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
        vol=$(awk '{printf "%d", $2*100+0.5}' <<<"$out")
        if [[ $out == *MUTED* ]]; then notify "Volume" 0 "mute"; else notify "Volume" "$vol" "${vol}%"; fi
        ;;
    mic)
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        if [[ $(wpctl get-volume @DEFAULT_AUDIO_SOURCE@) == *MUTED* ]]; then
            notify "Microphone" 0 "muted"
        else
            notify "Microphone" 100 "on"
        fi
        ;;
    brightness)
        case ${2:-} in
            up)   brightnessctl -e4 -n2 set 5%+ >/dev/null ;;
            down) brightnessctl -e4 -n2 set 5%- >/dev/null ;;
        esac
        pct=$(brightnessctl -m | cut -d, -f4)
        notify "Brightness" "${pct%\%}" "$pct"
        ;;
    *)
        echo "Usage: osd volume up|down|mute | mic | brightness up|down" >&2
        exit 1
        ;;
esac
