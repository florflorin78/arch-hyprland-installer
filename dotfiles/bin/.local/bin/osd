#!/usr/bin/env bash
# osd — schimbă volum / microfon / luminozitate și arată o notificare cu bară de progres (mako).
# Folosit de tastele Fn din hyprland.lua.   osd volume up|down|mute   osd mic   osd brightness up|down
set -u

notify() {   # notify TITLU PROCENT [TEXT]
    notify-send -t 1200 -h string:x-canonical-private-synchronous:osd -h "int:value:$2" "$1" "${3:-}"
}

case ${1:-} in
    volume)
        case ${2:-} in
            up)   wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
            down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
            mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
        esac
        out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)        # ex: "Volume: 0.45 [MUTED]"
        vol=$(awk '{printf "%d", $2*100+0.5}' <<<"$out")
        if [[ $out == *MUTED* ]]; then notify "Volum" 0 "mute"; else notify "Volum" "$vol" "${vol}%"; fi
        ;;
    mic)
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        if [[ $(wpctl get-volume @DEFAULT_AUDIO_SOURCE@) == *MUTED* ]]; then
            notify "Microfon" 0 "oprit"
        else
            notify "Microfon" 100 "pornit"
        fi
        ;;
    brightness)
        case ${2:-} in
            up)   brightnessctl -e4 -n2 set 5%+ >/dev/null ;;
            down) brightnessctl -e4 -n2 set 5%- >/dev/null ;;
        esac
        pct=$(brightnessctl -m | cut -d, -f4)               # ex: "50%"
        notify "Luminozitate" "${pct%\%}" "$pct"
        ;;
    *)
        echo "Folosire: osd volume up|down|mute | mic | brightness up|down" >&2
        exit 1
        ;;
esac
