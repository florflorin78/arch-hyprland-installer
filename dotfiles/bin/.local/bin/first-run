#!/usr/bin/env bash
# At first login, run post-install.sh in a terminal; never again after it succeeds.
marker="$HOME/.local/state/arch-hyprland/first-run-done"
[[ -e $marker ]] && exit 0

exec kitty --class float-term --title "First-run setup" \
    -e bash -lc '"$HOME/arch-hyprland-installer/post-install.sh"'
