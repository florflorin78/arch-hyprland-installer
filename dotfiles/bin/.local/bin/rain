#!/usr/bin/env bash
# Live data-rain wallpaper (kitty background panel + cmatrix). Opt-in, AC power only:
# it redraws the whole screen and costs GPU/CPU on the HD 520.
#   rain toggle | start | stop | auto   (auto: start on AC if enabled, stop on battery/eco)
state="$HOME/.local/state/arch-hyprland/rain"
mode_file="${XDG_RUNTIME_DIR:-/tmp}/hypr-power-mode"
clean="$HOME/Pictures/wallpapers/cyber-clean.png"
mkdir -p "$(dirname "$state")"

running() { pgrep -f 'kitten.*panel.*cmatrix' >/dev/null || pgrep -f 'kitty.*--edge=background' >/dev/null; }

start() {
    running && return 0
    [[ -f $clean ]] && "$HOME/.local/bin/wallpaper" "$clean"
    nohup kitty +kitten panel --edge=background --config=NONE \
        -o background_opacity=0 -o font_size=13 -o cursor_blink_interval=0 \
        cmatrix -ab -C cyan >/dev/null 2>&1 &
}

stop() {
    pkill -f 'kitty.*--edge=background' 2>/dev/null
    pkill -x cmatrix 2>/dev/null
    "$HOME/.local/bin/wallpaper"
}

case ${1:-toggle} in
    start)  echo on > "$state"; start ;;
    stop)   echo off > "$state"; stop ;;
    toggle) if running; then echo off > "$state"; stop; else echo on > "$state"; start; fi ;;
    auto)
        mode=$(cat "$mode_file" 2>/dev/null || echo normal)
        if [[ $(cat "$state" 2>/dev/null || echo off) == on && $mode == normal ]]; then start
        elif running; then stop; fi ;;
esac
