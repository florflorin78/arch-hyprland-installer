#!/usr/bin/env bash
# Adapt visual effects to the power source. hyprland.lua reads the mode from
# $XDG_RUNTIME_DIR/hypr-power-mode on every reload.
#   AC -> normal | battery -> no blur/shadows | eco (SUPER+F10) -> also no animations
#   power-watch          run in the background (started by Hyprland)
#   power-watch --once   apply once
rt=${XDG_RUNTIME_DIR:-/tmp}
state="$rt/hypr-power-mode"
eco="$rt/hypr-eco"

on_ac() {
    local f
    for f in /sys/class/power_supply/AC*/online /sys/class/power_supply/ADP*/online; do
        [[ -r $f && $(<"$f") == 1 ]] && return 0
    done
    return 1
}

apply() {
    local new=normal old
    if [[ -e $eco ]]; then new=eco; elif ! on_ac; then new=battery; fi
    old=$(cat "$state" 2>/dev/null || echo normal)
    if [[ $new != "$old" ]]; then
        echo "$new" > "$state"
        hyprctl reload >/dev/null 2>&1
        [[ $(cat "$HOME/.local/state/arch-hyprland/rain" 2>/dev/null) == on ]] && "$HOME/.local/bin/rain" auto &
    fi
}

apply
[[ ${1:-} == --once ]] && exit 0

udevadm monitor --udev --subsystem-match=power_supply 2>/dev/null | while read -r _; do
    sleep 1
    apply
done
