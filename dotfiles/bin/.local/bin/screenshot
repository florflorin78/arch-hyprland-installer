#!/usr/bin/env bash
# screenshot full|region — salvează în ~/Pictures/Screenshots și copiază în clipboard
set -eu
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%F_%H-%M-%S).png"

case ${1:-full} in
    full)   grim "$file" ;;
    region) geom=$(slurp) || exit 0
            grim -g "$geom" "$file" ;;
    *)      echo "Folosire: screenshot full|region" >&2; exit 1 ;;
esac

wl-copy < "$file"
notify-send "Screenshot salvat" "$file"
