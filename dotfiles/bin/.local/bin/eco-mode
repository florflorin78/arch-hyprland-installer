#!/usr/bin/env bash
# Toggle (SUPER+F10): no blur/shadows/animations, 30% brightness.
rt=${XDG_RUNTIME_DIR:-/tmp}
eco="$rt/hypr-eco"

if [[ -e $eco ]]; then
    rm -f "$eco"
    brightnessctl -r >/dev/null 2>&1
    msg="OFF"
else
    : > "$eco"
    brightnessctl -s set 30% >/dev/null 2>&1
    msg="ON (no effects, 30% brightness)"
fi

"$HOME/.local/bin/power-watch" --once
notify-send "Eco mode" "$msg"
