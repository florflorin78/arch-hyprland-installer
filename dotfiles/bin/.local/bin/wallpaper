#!/usr/bin/env bash
# wallpaper [next|FILE]: restore, cycle, or set a wallpaper (swaybg).
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/wallpaper.lock"
flock 9

dir="$HOME/Pictures/wallpapers"
state="$HOME/.local/state/arch-hyprland/wallpaper"
# -L: the wallpapers are stow symlinks, plain "-type f" would skip them all
mapfile -t files < <(find -L "$dir" -maxdepth 1 -type f \( -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' \) ! -name 'cyber-clean.png' | sort)
((${#files[@]})) || exit 1
if [[ -f ${1:-} ]]; then pkill -x swaybg; swaybg -i "$1" -m fill 9>&- & disown; exit 0; fi
cur=$(cat "$state" 2>/dev/null || echo 0)
[[ $cur =~ ^[0-9]+$ ]] || cur=0
cur=$((cur % ${#files[@]}))                 # the list may have shrunk since last time
[[ ${1:-} == next ]] && cur=$(((cur + 1) % ${#files[@]}))
echo "$cur" > "$state"
pkill -x swaybg
swaybg -i "${files[cur]}" -m fill 9>&- & disown
