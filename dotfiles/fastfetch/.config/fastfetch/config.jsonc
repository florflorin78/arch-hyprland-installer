{
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "yellow", "2": "cyan", "3": "blue" },
        "padding": { "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "yellow", "output": "cyan", "title": "yellow" }
    },
    "modules": [
        "title",
        { "type": "os", "key": "os    " },
        { "type": "host", "key": "host  " },
        { "type": "kernel", "key": "kernel" },
        { "type": "uptime", "key": "uptime" },
        { "type": "packages", "key": "pkgs  " },
        { "type": "shell", "key": "shell " },
        { "type": "wm", "key": "wm    " },
        { "type": "terminal", "key": "term  " },
        { "type": "cpu", "key": "cpu   " },
        { "type": "memory", "key": "ram   " },
        { "type": "disk", "key": "disk  " },
        { "type": "battery", "key": "power " }
    ]
}
