{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window", "mpris"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/updates", "idle_inhibitor", "custom/dnd", "cpu", "memory", "disk", "temperature", "backlight", "pulseaudio", "network", "bluetooth", "battery", "hyprland/language", "custom/power"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },

    "hyprland/language": {
        "format": " {short}"
    },

    "clock": {
        "format": "{:%a %d %b   %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 5
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 10
    },

    "temperature": {
        "format": " {temperatureC}°",
        "critical-threshold": 85,
        "interval": 10
    },

    "backlight": {
        "format": " {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " mute",
        "format-icons": { "default": ["", ""] },
        "on-click": "kitty --class float-term -e pulsemixer"
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "ETH {ipaddr}",
        "format-disconnected": " offline",
        "tooltip-format-wifi": "{essid}  {ipaddr}  ({signalStrength}%)",
        "on-click": "kitty --class float-term -e nmtui"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": " {num_connections}",
        "on-click": "kitty --class float-term -e bluetui"
    },

    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}  ({power}W)",
        "interval": 20
    },

    "mpris": {
        "format": "{player_icon} {title} — {artist}",
        "format-paused": "{status_icon} {title}",
        "player-icons": { "default": "\uf001" },
        "status-icons": { "paused": "\uf04c" },
        "max-length": 40,
        "ignored-players": ["firefox"]
    },

    "custom/updates": {
        "exec": "~/.local/bin/updates-count",
        "interval": 3600,
        "format": "\uf021 {}",
        "tooltip": false,
        "on-click": "kitty --class float-term -e sh -c 'sudo pacman -Syu; read -rp \"Enter to close\"'"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "\uf0f4", "deactivated": "\uf06e" },
        "tooltip-format-activated": "Stay awake: ON",
        "tooltip-format-deactivated": "Stay awake: off"
    },

    "custom/dnd": {
        "exec": "~/.local/bin/dnd status",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.local/bin/dnd toggle",
        "tooltip": false
    },

    "disk": {
        "format": "\uf0a0 {percentage_used}%",
        "interval": 60,
        "tooltip-format": "{used} / {total}"
    },

    "tray": { "spacing": 8 },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.local/bin/powermenu"
    }
}
