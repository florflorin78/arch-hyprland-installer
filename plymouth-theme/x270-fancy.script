// x270-fancy.script — animație minimalistă: fundal negru + un cerc care se rotește în centru
// Plymouth folosește un limbaj propriu, simplu, tip JavaScript vechi.

Window.SetBackgroundTopColor(0.05, 0.05, 0.07);
Window.SetBackgroundBottomColor(0.05, 0.05, 0.07);

// Text mic, minimalist, sub cerc
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetWidth() / 2 - 60, Window.GetHeight() / 2 + 60, 10000);

fun refresh_callback() {
    // desenăm un cerc simplu care se rotește, format din puncte
    angle = (Plymouth.GetTime() * 180) % 360;
    num_dots = 8;
    radius = 30;
    center_x = Window.GetWidth() / 2;
    center_y = Window.GetHeight() / 2;

    for (i = 0; i < num_dots; i++) {
        dot_angle = angle + (i * 360 / num_dots);
        dot_x = center_x + radius * Math.Cos(dot_angle * 3.14159 / 180);
        dot_y = center_y + radius * Math.Sin(dot_angle * 3.14159 / 180);

        if (Plymouth.GetMode() != "shutdown") {
            opacity = 0.3 + 0.7 * (i / num_dots);
        }
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback(text) {
    message_sprite.SetText(text);
}
Plymouth.SetMessageFunction(message_callback);
